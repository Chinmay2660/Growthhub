# GrowthHub environment variables
#
# Local setup:   cp .env.example .env.local      (never commit the real file)
# Then set MONGODB_URI and SESSION_SECRET below and run:  npm run dev   ->  http://localhost:4000
#
# Next.js loads .env.local automatically in development and `next build` / `next start`.
# In production (Vercel etc.) set the same names in the host's environment settings.

# ── Required ─────────────────────────────────────────────────────────────────

# MongoDB connection string (local or Atlas).
MONGODB_URI=mongodb://127.0.0.1:27017/platform
# Atlas example:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/platform?retryWrites=true&w=majority
# Without it the app stops with "Missing MONGODB_URI environment variable".

# Signs session cookies. Use a long random value, e.g.:  openssl rand -hex 32
# Required in production. If you also run CareerFlow and want one shared login,
# MONGODB_URI and SESSION_SECRET must be identical in both apps.
SESSION_SECRET=change-me-to-a-long-random-string

# ── Demo ─────────────────────────────────────────────────────────────────────

# "Try demo" on the login page opens ONE shared account: every visitor sees and changes the same data.
# Always available in development. In production it is off unless you set this to true.
# ALLOW_GUEST_AUTH=true

# ── Optional: security ───────────────────────────────────────────────────────

# Login rate limiting. On in production, off in development; set to true/false to override.
# RATE_LIMIT_ENABLED=true
# AUTH_RATE_LIMIT_ENABLED=true

# Share the session cookie across subdomains in production (e.g. .yourdomain.com).
# COOKIE_DOMAIN=.yourdomain.com

# ── Optional: this app's own URL ─────────────────────────────────────────────

# Public URL of GrowthHub (used for links back to this app). Default: http://localhost:4000
# GROWTHHUB_URL=http://localhost:4000

# ── Optional: CareerFlow integration (Google sign-in and the sidebar link) ───
# Skip these if you do not run CareerFlow. The defaults below are for local development.

# CAREERFLOW_URL=http://localhost:3000
# CAREERFLOW_API_URL=http://localhost:8000
# Browser-visible: used for the sidebar / login link to CareerFlow.
# NEXT_PUBLIC_CAREERFLOW_URL=http://localhost:3000
# Google OAuth itself is configured in CareerFlow's backend/.env (GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET).
# GrowthHub does not use JWTs.

# Older names still read as fallbacks (prefer the CAREERFLOW_* ones above):
# JOB_TRACKER_URL, JOB_TRACKER_API_URL, NEXT_PUBLIC_JOB_TRACKER_URL, SWITCH_PREP_URL, NEXT_PUBLIC_APP_URL
